## 12. ЭТАЛОННЫЙ ЭНДПОИНТ

```python
from fastapi import APIRouter, Depends
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select
from pydantic import BaseModel
from typing import List, Optional

from app.database import get_db
from app.models.user import User
from app.models.trip import Trip, TripStatus
from app.api.v1.deps.auth import verify_api_key
from app.core.integrations.max_bot import MaxBotAPI

router = APIRouter(prefix="/import", tags=["Import"])
bot = MaxBotAPI()


class ItemSchema(BaseModel):
    code: str
    value: Optional[int] = None


class RequestSchema(BaseModel):
    items: List[ItemSchema]


@router.post("/my-endpoint")
async def my_endpoint(
    request: RequestSchema,
    _: bool = Depends(verify_api_key),
    db: AsyncSession = Depends(get_db),
):
    """Описание эндпоинта."""
    created = []
    errors = []

    for item in request.items:
        try:
            result = await db.execute(
                select(User).where(User.code == item.code)
            )
            user = result.scalar_one_or_none()
            if not user:
                errors.append({"code": item.code, "error": "Не найден"})
                continue

            # ... логика ...

            await db.commit()

            if user.max_user_id:
                await bot.send_message(user.max_user_id, "Готово")

            created.append({"code": item.code, "status": "created"})

        except Exception as e:
            await db.rollback()
            errors.append({"code": item.code, "error": str(e)})

    return {
        "status": "completed",
        "created": created,
        "errors": errors,
    }
```

