# Database
DATABASE_URL=postgresql+asyncpg://logistics_user:secure_password@postgres:5432/logistics_db

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MAX Bot (пока заглушки)
MAX_BOT_TOKEN=your_max_bot_token_here
MAX_BOT_NAME=YourBotName

# Application
DEBUG=True
CORS_ORIGINS=["*"]
